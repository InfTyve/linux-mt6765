# MT6765 bring-up config fragment
#
# Used together with arm64 defconfig:
#   make ARCH=arm64 LLVM=1 defconfig
#   scripts/kconfig/merge_config.sh -m .config arch/arm64/configs/mt6765.config
#   make ARCH=arm64 LLVM=1 olddefconfig
#
# Keeps the defconfig breadth but makes sure every block described in
# mt6765.dtsi actually has a driver compiled in.

# --- platform -------------------------------------------------------------
CONFIG_ARCH_MEDIATEK=y
CONFIG_ARM64=y
CONFIG_ARM_PSCI_FW=y
CONFIG_SMP=y

# --- clocks ---------------------------------------------------------------
CONFIG_COMMON_CLK_MT6765=y

# --- pinctrl / GPIO / EINT ------------------------------------------------
CONFIG_PINCTRL_MTK_PARIS=y
CONFIG_PINCTRL_MT6765=y
CONFIG_EINT_MTK=y

# --- timers ---------------------------------------------------------------
CONFIG_MTK_TIMER=y

# --- serial console -------------------------------------------------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_OF_PLATFORM=y

# --- PMIC / regulators ----------------------------------------------------
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_MT6357=y
CONFIG_RTC_DRV_MT6397=y
CONFIG_KEYBOARD_MTK_PMIC=y

# --- storage --------------------------------------------------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ARASAN=y

# --- filesystems needed to mount a rootfs --------------------------------
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_VFAT_FS=y

# --- Android userspace plumbing -------------------------------------------
# Enough to let a vendor Android init survive its first stage: binder,
# dma-buf heaps (the ION replacement) built in rather than modular, and
# SELinux.  /dev/ashmem and the vendor .ko modules are still unavailable
# on a 7.x kernel, so this only gets a vendor init past its first stage.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_LSM="lockdown,yama,selinux,bpf"
CONFIG_PSI=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y

# --- debug ----------------------------------------------------------------
CONFIG_DEBUG_INFO_NONE=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
